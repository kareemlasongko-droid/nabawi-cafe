# =============================================================================
#  Senja Rimba — contoh environment variable
# =============================================================================
#  Development : salin file ini menjadi `.env.local` lalu isi nilainya.
#  Vercel      : set lewat Dashboard → Project → Settings → Environment
#                Variables. Isi untuk Production, Preview, DAN Development.
#  Jalur mudah : bila Supabase dibuat lewat integrasi Vercel Marketplace,
#                variabel POSTGRES_URL, POSTGRES_URL_NON_POOLING, SUPABASE_URL,
#                SUPABASE_SECRET_KEY, dan NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#                disinkronkan otomatis — aplikasi menerimanya sebagai fallback
#                dari nama-nama di bawah, jadi tidak perlu diset manual.
#                Lihat PANDUAN-DEPLOY.md.
#
#  JANGAN pernah mengirim file .env.local, password database, service_role key,
#  atau CRON_SECRET ke chat, issue, atau commit Git.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. DATABASE — runtime aplikasi
# -----------------------------------------------------------------------------
#  WAJIB ada sebelum `next build`. Tanpa variabel ini build gagal dengan
#  "Error: DATABASE_URL is required" (lihat src/db/index.ts).
#
#  Development (Postgres lokal):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
#  Vercel + Supabase → pakai SHARED POOLER mode TRANSACTION (port 6543).
#  Host direct (db.<ref>.supabase.co) itu IPv6-only dan tidak terjangkau dari
#  Vercel; session pooler (5432) membuat tiap instance menahan koneksi saat
#  idle sehingga cepat menghabiskan slot. Jadi untuk runtime: 6543.
#
#  Ambil dari Dashboard → Connect → Transaction pooler, lalu ganti
#  [YOUR-PASSWORD] (URL-encode bila mengandung karakter khusus, mis. @ → %40).
#
#  DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres


# -----------------------------------------------------------------------------
#  2. DATABASE — khusus migrasi (drizzle-kit)
# -----------------------------------------------------------------------------
#  Dipakai oleh `npm run db:push|migrate|generate|studio`. Harus koneksi
#  SESSION (port 5432) atau direct, karena DDL tidak andal lewat transaction
#  pooler. Ambil dari Dashboard → Connect → Session pooler.
#
#  DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres


# -----------------------------------------------------------------------------
#  3. TLS DATABASE (opsional)
# -----------------------------------------------------------------------------
#  Default: koneksi ke host non-lokal otomatis dienkripsi DAN sertifikatnya
#  diverifikasi (rejectUnauthorized: true). Ini aman untuk host pooler Supabase
#  yang memakai CA publik.
#
#  Hanya isi bila benar-benar perlu:
#    disable   → tanpa TLS (jangan untuk production)
#    no-verify → TLS aktif tapi sertifikat tidak diverifikasi
#  DATABASE_SSL=

#  Penyetelan pool koneksi per instance (opsional, default di sebelah kanan):
#  PGPOOL_MAX=10                        # jangan diset 1 di Vercel
#  PGPOOL_IDLE_MS=10000
#  PGPOOL_CONNECT_TIMEOUT_MS=5000


# -----------------------------------------------------------------------------
#  4. SUPABASE STORAGE — untuk unggah gambar & bukti transfer
# -----------------------------------------------------------------------------
#  Dua variabel di bawah WAJIB ada saat BUILD, karena dipakai komponen browser
#  (src/components/ui.tsx). Tanpa keduanya tombol unggah akan gagal.
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ANON-PUBLIC-KEY]

#  Hanya untuk SERVER. Key ini bypass RLS — jangan pernah diberi prefix
#  NEXT_PUBLIC_ dan jangan pernah masuk ke bundle browser.
SUPABASE_SERVICE_ROLE_KEY=[SERVICE-ROLE-KEY]

#  Nama bucket (opsional). Default: "media" dan "bukti-transfer".
#  Keduanya dibuat oleh supabase/setup.sql.
#  SUPABASE_MEDIA_BUCKET=media
#  SUPABASE_PROOF_BUCKET=bukti-transfer

#  Batas unggah sisi server dalam MB (opsional, default 25).
#  Supabase Free sendiri membatasi 50 MB per file.
#  MAX_UPLOAD_MB=25


# -----------------------------------------------------------------------------
#  5. SEED DATA DEMO — penting untuk keamanan
# -----------------------------------------------------------------------------
#  Seeder membuat akun admin@senjarimba.id / admin123 yang kredensialnya ada di
#  repositori publik ini. Default: NYALA di development, MATI di production.
#
#  Biarkan kosong / tidak di-set di production. Hanya isi "true" bila Anda
#  memang sengaja ingin mengisi data demo.
#  SEED_DEMO_DATA=


# -----------------------------------------------------------------------------
#  6. CRON — penjaga database Free tetap hidup
# -----------------------------------------------------------------------------
#  Supabase mem-pause project Free setelah 7 hari tanpa aktivitas database.
#  Vercel Cron memanggil /api/cron/keepalive tiap Senin (lihat vercel.json).
#  Buat string acak panjang, mis. hasil dari: openssl rand -hex 32
CRON_SECRET=
