{
  "name": "nabawi-cafe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "uji:aturan": "node --experimental-strip-types --no-warnings --import ./scripts/uji/ts-hook.mjs scripts/uji/aturan-pilihan.mjs",
    "uji:jalur": "node --experimental-strip-types --no-warnings --import ./scripts/uji/ts-hook.mjs scripts/uji/jalur-pilihan.mjs",
    "uji:env": "node --experimental-strip-types --no-warnings --import ./scripts/uji/ts-hook.mjs scripts/uji/env-kosong.mjs",
    "uji:saring": "node --experimental-strip-types --no-warnings --import ./scripts/uji/ts-hook.mjs scripts/uji/saring-admin.mjs",
    "uji:prabayar": "node --experimental-strip-types --no-warnings --import ./scripts/uji/ts-hook.mjs scripts/uji/prabayar.mjs",
    "uji:lunas": "node --experimental-strip-types --no-warnings --import ./scripts/uji/ts-hook.mjs scripts/uji/alur-lunas.mjs",
    "uji:alur": "node scripts/uji/alur-http.mjs",
    "uji:invoice": "node --experimental-strip-types --no-warnings --import ./scripts/uji/ts-hook.mjs scripts/uji/invoice.mjs",
    "uji:invoice:http": "node scripts/uji/invoice-http.mjs",
    "uji:meja": "node --experimental-strip-types --no-warnings --import ./scripts/uji/ts-hook.mjs scripts/uji/meja-qr.mjs",
    "uji:ui": "node scripts/uji/perubahan-ui-http.mjs",
    "uji:http": "node scripts/uji/regresi.mjs && node scripts/uji/kepala-portal.mjs && node scripts/uji/bug-audit.mjs && node scripts/uji/pilihan.mjs && npm run uji:sampai --silent",
    "uji:sampai": "node --experimental-strip-types --no-warnings --import ./scripts/uji/ts-hook.mjs scripts/uji/pilihan-sampai.ts",
    "uji:kepala": "node scripts/uji/kepala-portal.mjs",
    "uji:bug": "node scripts/uji/bug-audit.mjs",
    "uji:menu": "node --experimental-strip-types --no-warnings --import ./scripts/uji/ts-hook.mjs scripts/uji/menu-halaman.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:cf": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "verifikasi": "node scripts/uji/verifikasi-deploy.mjs",
    "uji:riwayat": "node --experimental-strip-types --no-warnings --import ./scripts/uji/ts-hook.mjs scripts/uji/riwayat.mjs",
    "uji:riwayat:http": "node scripts/uji/riwayat-http.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.18",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "wrangler": "^4.166.0"
  },
  "packageManager": "npm@10.9.8"
}
